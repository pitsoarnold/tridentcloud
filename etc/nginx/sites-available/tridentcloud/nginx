server {
    listen 80;
    listen [::]:80;
    server_name tridentcloud.185.182.9.86.nip.io;

    # Let's Encrypt HTTP challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tridentcloud.185.182.9.86.nip.io;

    ssl_certificate     /etc/letsencrypt/live/tridentcloud.185.182.9.86.nip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tridentcloud.185.182.9.86.nip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Security headers (additive — does NOT block iframe embedding)
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # NOTE: no X-Frame-Options or CSP frame-ancestors → Trident can be embedded
    # If you want Trident embeddable BY OTHERS, leave as-is.
    # If you want to prevent OTHERS embedding Trident, add:
    # add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 25M;  # for case study screenshot uploads

    location / {
        proxy_pass http://127.0.0.1:3097;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}